# HepatoX Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=production
FLASK_APP=app.py
DEBUG=False

# Secret key for sessions (generate a random string)
SECRET_KEY=your-secret-key-here-generate-a-random-string

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For local development (SQLite):
# DATABASE_URL=sqlite:///instance/hepatox.db

# For Neon PostgreSQL (Render deployment):
# Format: postgresql://user:password@host:5432/database_name
DATABASE_URL=postgresql://user:password@host:5432/hepatox

# ============================================================================
# ADMIN USER (CREATED ON FIRST RUN)
# ============================================================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@hepatox.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# ============================================================================
# RENDER DEPLOYMENT
# ============================================================================
# Set to https in production
DOMAIN=localhost:5000
PROTOCOL=http

# ============================================================================
# EMAIL CONFIGURATION (OPTIONAL - FOR PASSWORD RESET)
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# ============================================================================
# ANALYTICS & MONITORING (OPTIONAL)
# ============================================================================
# Sentry DSN for error tracking
SENTRY_DSN=

# ============================================================================
# API KEYS (IF ANY THIRD-PARTY SERVICES ARE USED)
# ============================================================================
# Add any additional API keys here
